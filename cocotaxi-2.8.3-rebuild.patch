@@ -0,0 +1,107 @@
+package com.cocotaxi.app;
+
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Reads only explicit acceptance-rate requirements shown in a Cabify promotion screen. */
+public final class PromotionRequirementParser {
+  private static final String NUMBER = "(?<rate>[0-9]{1,3}(?:[.,][0-9]+)?)";
+  private static final Pattern TARGET_AFTER_LABEL =
+      Pattern.compile(
+          "(?:ta|tasa(?: de)? aceptacion)[^%\\n]{0,45}?(?:min(?:ima|imo)?|objetivo|meta|requerid[ao])[^0-9%\\n]{0,20}"
+              + NUMBER
+              + "\\s*%");
+  private static final Pattern TARGET_BEFORE_RATE =
+      Pattern.compile(
+          "(?:min(?:ima|imo)?|objetivo|meta|requerid[ao])[^0-9%\\n]{0,24}"
+              + NUMBER
+              + "\\s*%[^\\n]{0,35}(?:ta|tasa(?: de)? aceptacion)");
+  private static final Pattern TARGET_STANDALONE =
+      Pattern.compile(
+          "(?m)^(?:min(?:ima|imo)?|objetivo|meta|requerid[ao])[^0-9%\\n]{0,24}"
+              + NUMBER
+              + "\\s*%");
+  private static final Pattern CURRENT =
+      Pattern.compile(
+          "(?:tu\\s+(?:ta|tasa(?: de)? aceptacion)|(?:ta|tasa(?: de)? aceptacion)\\s+actual)[^0-9%\\n]{0,24}"
+              + NUMBER
+              + "\\s*%");
+  private static final Pattern CURRENT_PREFIX =
+      Pattern.compile("(?:actual|actualmente)[^%\\n]{0,45}" + NUMBER + "\\s*%");
+  private static final Pattern CURRENT_BLOCK =
+      Pattern.compile(
+          "(?:tu\\s+(?:ta|tasa(?: de)? aceptacion)(?:\\s+actual)?|actualmente)[^%]{0,60}?"
+              + NUMBER
+              + "\\s*%");
+  private static final Pattern OFFERED =
+      Pattern.compile("(?:viajes|ofertas)\\s+(?:recibidos|recibidas|ofrecidos|ofrecidas)\\D{0,12}([0-9]{1,4})");
+  private static final Pattern ACCEPTED =
+      Pattern.compile("(?:viajes|ofertas)\\s+(?:aceptados|aceptadas)\\D{0,12}([0-9]{1,4})");
+  private static final Pattern TRIP_TARGET =
+      Pattern.compile("(?:meta|objetivo)?\\s*([0-9]{1,3})\\s+viajes\\b");
+
+  private PromotionRequirementParser() {}
+
+  public static Requirement parse(String raw) {
+    Requirement out = new Requirement();
+    String text = OfferParser.normalize(raw == null ? "" : raw);
+    boolean rateContext = text.contains("tasa de aceptacion") || text.matches("(?s).*\\bta\\b.*");
+    boolean promotionContext =
+        text.contains("promocion")
+            || text.contains("promo")
+            || text.contains("premio")
+            || text.contains("recompensa")
+            || text.contains("viajes para conseguir");
+    if (!rateContext || !promotionContext) return out;
+
+    out.targetRate = first(TARGET_AFTER_LABEL, text);
+    if (out.targetRate < 0) out.targetRate = first(TARGET_BEFORE_RATE, text);
+    if (out.targetRate < 0) out.targetRate = first(TARGET_STANDALONE, text);
+    out.currentRate = first(CURRENT, text);
+    if (out.currentRate < 0) out.currentRate = first(CURRENT_PREFIX, text);
+    if (out.currentRate < 0) out.currentRate = first(CURRENT_BLOCK, text);
+    out.offeredJourneys = integer(OFFERED, text);
+    out.acceptedJourneys = integer(ACCEPTED, text);
+    out.tripTarget = integer(TRIP_TARGET, text);
+    out.found = out.targetRate > 0 && out.targetRate <= 100;
+    if (out.currentRate > 100) out.currentRate = -1;
+    if (out.offeredJourneys >= 0
+        && out.acceptedJourneys > out.offeredJourneys) {
+      out.offeredJourneys = -1;
+      out.acceptedJourneys = -1;
+    }
+    return out;
+  }
+
+  private static double first(Pattern pattern, String text) {
+    Matcher matcher = pattern.matcher(text);
+    if (!matcher.find()) return -1;
+    try {
+      String value;
+      try {
+        value = matcher.group("rate");
+      } catch (IllegalArgumentException noNamedGroup) {
+        value = matcher.group(1);
+      }
+      return Double.parseDouble(value.replace(',', '.'));
+    } catch (RuntimeException ignored) {
+      return -1;
+    }
+  }
+
+  private static int integer(Pattern pattern, String text) {
+    Matcher matcher = pattern.matcher(text);
+    if (!matcher.find()) return -1;
+    try {
+      return Integer.parseInt(matcher.group(1));
+    } catch (RuntimeException ignored) {
+      return -1;
+    }
+  }
+
+  public static final class Requirement {
+    public boolean found;
+    public double targetRate = -1, currentRate = -1;
+    public int offeredJourneys = -1, acceptedJourneys = -1, tripTarget = -1;
+  }
+}
