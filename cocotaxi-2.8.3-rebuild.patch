diff --git a/app/src/main/java/com/cocotaxi/app/SpatialDemandVision.java b/app/src/main/java/com/cocotaxi/app/SpatialDemandVision.java
new file mode 100644
index 0000000..1215cd5
--- /dev/null
+++ b/app/src/main/java/com/cocotaxi/app/SpatialDemandVision.java
@@ -0,0 +1,348 @@
+package com.cocotaxi.app;
+
+import android.graphics.Bitmap;
+import android.graphics.Color;
+import android.graphics.Rect;
+import java.util.*;
+
+/**
+ * Screen-only heat-map memory. Demand is stored primarily as colored cells plus visual landmarks;
+ * barrio/street text is a secondary anchor. No GPS, geocoder or private endpoint is used.
+ */
+public final class SpatialDemandVision {
+  private static final long FRESH_MS = 6 * 60_000L;
+  private static final int MAX_LABELS = 100;
+  private static final int COLS = 18, ROWS = 28;
+  private static final float MAP_LEFT = .08f, MAP_RIGHT = .92f, MAP_TOP = .12f, MAP_BOTTOM = .82f;
+
+  private final LinkedHashMap<String, HotLabel> labels = new LinkedHashMap<>();
+  private final LinkedHashMap<String, Landmark> landmarks = new LinkedHashMap<>();
+  private final byte[] cells = new byte[COLS * ROWS];
+  private long sampledAt;
+  private int overallSignal = -1;
+  private boolean hasGrid;
+
+  public synchronized int observe(
+      Bitmap bitmap, ScreenOcrEngine.Frame frame, String normalized, long now) {
+    if (bitmap == null || frame == null || OfferParser.isHistoryNormalized(normalized)) return -1;
+    int overall = overallHeat(bitmap);
+    boolean mapLike =
+        DemandModel.isMapScreenNormalized(normalized)
+            || (!OfferParser.isLikelyOfferNormalized(normalized) && overall >= 2);
+    if (!mapLike) return -1;
+
+    sampleCells(bitmap);
+    sampledAt = now;
+    overallSignal = overall;
+    for (ScreenOcrEngine.LineInfo line : frame.lines) {
+      String label = OfferParser.normalize(line.text).trim();
+      if (!usefulMapLabel(label)) continue;
+      String key = canonical(label);
+      if (key.isEmpty() || line.bounds == null || line.bounds.isEmpty()) continue;
+      float x = line.bounds.exactCenterX() / Math.max(1f, bitmap.getWidth());
+      float y = line.bounds.exactCenterY() / Math.max(1f, bitmap.getHeight());
+      int heat = Math.max(cellHeat(x, y), heatAround(bitmap, line.bounds));
+      landmarks.put(key, new Landmark(x, y, now));
+      if (heat >= 2) labels.put(key, new HotLabel(key, heat, now));
+    }
+    prune(now);
+    return Math.max(overall, DemandModel.textSignalNormalized(normalized));
+  }
+
+  /** Accessibility-only path: use fresh named anchors but never call an unknown address cold. */
+  public synchronized void annotate(Offer offer, long now) {
+    if (offer == null) return;
+    prune(now);
+    if (!fresh(now)) return;
+    offer.pickupHeat = classify(offer.pickupArea, now);
+    offer.destinationHeat = classify(offer.destinationArea, now);
+    offer.zoneEvidence = offer.pickupHeat >= 0 && offer.destinationHeat >= 0;
+  }
+
+  /** Aligns current map labels with the saved demand grid and projects offer labels into it. */
+  public synchronized void annotate(
+      Offer offer, Bitmap bitmap, ScreenOcrEngine.Frame frame, long now) {
+    annotate(offer, now);
+    if (offer == null || bitmap == null || frame == null || !fresh(now) || !hasGrid) return;
+    Alignment alignment = alignment(bitmap, frame, now);
+    if (alignment == null) return;
+    if (offer.pickupHeat < 0)
+      offer.pickupHeat = classifyProjected(offer.pickupArea, bitmap, frame, alignment);
+    if (offer.destinationHeat < 0)
+      offer.destinationHeat = classifyProjected(offer.destinationArea, bitmap, frame, alignment);
+    offer.zoneEvidence = offer.pickupHeat >= 0 && offer.destinationHeat >= 0;
+  }
+
+  public synchronized int classify(String address, long now) {
+    prune(now);
+    if (!fresh(now)) return -1;
+    String a = canonical(address);
+    if (a.isEmpty()) return -1;
+    Set<String> addressTokens = tokens(a);
+    int bestHeat = -1, bestScore = 0;
+    for (HotLabel h : labels.values()) {
+      int score = overlap(addressTokens, tokens(h.label));
+      if (!h.label.isEmpty() && (a.contains(h.label) || h.label.contains(a))) score += 3;
+      if (score > bestScore || score == bestScore && score > 0 && h.heat > bestHeat) {
+        bestScore = score;
+        bestHeat = h.heat;
+      }
+    }
+    return bestScore >= 1 ? bestHeat : -1;
+  }
+
+  public synchronized int overallSignal(long now) {
+    return fresh(now) ? overallSignal : -1;
+  }
+
+  synchronized void rememberForTests(String label, int heat, long now) {
+    String key = canonical(label);
+    labels.put(key, new HotLabel(key, heat, now));
+    landmarks.put(key, new Landmark(.5f, .5f, now));
+    sampledAt = now;
+    overallSignal = Math.max(overallSignal, heat);
+  }
+
+  private int classifyProjected(
+      String address, Bitmap bitmap, ScreenOcrEngine.Frame frame, Alignment alignment) {
+    String wanted = canonical(address);
+    if (wanted.isEmpty()) return -1;
+    Set<String> wantedTokens = tokens(wanted);
+    ScreenOcrEngine.LineInfo best = null;
+    int bestScore = 0;
+    for (ScreenOcrEngine.LineInfo line : frame.lines) {
+      String candidate = canonical(line.text);
+      if (candidate.isEmpty() || line.bounds == null || line.bounds.isEmpty()) continue;
+      int score = overlap(wantedTokens, tokens(candidate));
+      if (wanted.contains(candidate) || candidate.contains(wanted)) score += 3;
+      if (score > bestScore) {
+        bestScore = score;
+        best = line;
+      }
+    }
+    if (best == null || bestScore < 1) return -1;
+    float currentX = best.bounds.exactCenterX() / Math.max(1f, bitmap.getWidth());
+    float currentY = best.bounds.exactCenterY() / Math.max(1f, bitmap.getHeight());
+    return cellHeat(alignment.scale * currentX + alignment.dx, alignment.scale * currentY + alignment.dy);
+  }
+
+  private Alignment alignment(Bitmap bitmap, ScreenOcrEngine.Frame frame, long now) {
+    List<float[]> pairs = new ArrayList<>();
+    for (ScreenOcrEngine.LineInfo line : frame.lines) {
+      String key = canonical(line.text);
+      Landmark old = landmarks.get(key);
