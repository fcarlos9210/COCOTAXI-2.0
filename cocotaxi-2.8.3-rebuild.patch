+    s.acceptanceRequired = true;
+    s.acceptanceTarget = clampRate(r.targetRate);
+    s.acceptanceCurrent = r.currentRate > 0 ? clampRate(r.currentRate) : -1;
+    s.offeredJourneys = r.offeredJourneys;
+    s.acceptedJourneys = r.acceptedJourneys;
+    s.acceptanceObservedAt = now;
+    write(c, raw);
+    return true;
+  }
+
+  private static double clampRate(double value) {
+    if (!Double.isFinite(value)) return -1;
+    return Math.max(0, Math.min(100, value));
+  }
