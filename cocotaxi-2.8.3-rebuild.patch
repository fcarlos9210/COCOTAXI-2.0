+  /** Stable Compose/test ids observed on Cabify's active journey screen. */
+  public static boolean isAssignedSemantic(String id) {
+    if (id == null) return false;
+    String value = semantic(id);
+    return (value.contains("jf_journey_screen") || value.contains("journey_screen"))
+        && !value.contains("journey_offer")
+        && !isCancellationSemantic(value)
+        && !isCompletionSemantic(value);
+  }
+
+  /** Terminal cancellation screens only; the ordinary "Cancelar viaje" action is not terminal. */
+  public static boolean isCancellationSemantic(String id) {
+    if (id == null) return false;
+    String value = semantic(id);
+    return value.contains("journey_cancelled")
+        || value.contains("journey_canceled")
+        || value.contains("cancelled_journey")
+        || value.contains("canceled_journey")
+        || value.contains("cancellation_success")
+        || value.contains("cancel_journey_success");
+  }
+
+  /**
+   * Detects a confirmed cancellation by the passenger or driver. Deliberately excludes the
+   * infinitive action "Cancelar viaje", which remains visible during a normal active journey.
+   */
+  public static boolean isCancelledNormalized(String text) {
+    if (text == null || OfferParser.isHistoryNormalized(text)) return false;
+    return text.contains("viaje cancelado")
+        || text.contains("viaje ha sido cancelado")
+        || text.contains("viaje fue cancelado")
+        || text.contains("has cancelado el viaje")
+        || text.contains("cancelaste el viaje")
+        || text.contains("cancelacion confirmada")
+        || text.contains("pasajero cancelo")
+        || text.contains("usuario cancelo")
+        || text.contains("cliente cancelo");
+  }
+
+  /** The confirmation button is distinct from the first Finish slider/button. */
+  public static boolean isFinishConfirmationSemantic(String id) {
+    if (id == null) return false;
+    String value = semantic(id);
+    return value.contains("finish_warning_dialog_finish_button")
+        || value.contains("finish_confirmation_confirm")
+        || value.contains("confirm_finish_journey")
+        || value.contains("confirm_end_journey");
+  }
+
+  /** Semantic screens that only appear once Cabify has completed the journey. */
+  public static boolean isCompletionSemantic(String id) {
+    if (id == null) return false;
+    String value = semantic(id);
+    return value.contains("journey_finished")
+        || value.contains("journey_completed")
+        || value.contains("completed_journey")
+        || value.contains("journey_summary")
+        || value.contains("rate_journey")
+        || value.contains("rating_screen");
+  }
+
+  public static boolean isCompletedNormalized(String text) {
+    if (text == null || OfferParser.isHistoryNormalized(text)) return false;
+    return text.contains("viaje finalizado")
+        || text.contains("viaje terminado")
+        || text.contains("viaje completado")
+        || text.contains("califica el viaje")
+        || text.contains("calificar viaje")
+        || text.contains("resumen del viaje");
+  }
+
+  /** Main-map evidence used only after the driver explicitly requested Finish. */
+  public static boolean isPostTripMapNormalized(String text) {
+    if (text == null || text.isEmpty()) return false;
+    return text.contains("buscar viajes")
+        || text.contains("estas conectado")
+        || text.contains("estas en linea")
+        || text.contains("viajes disponibles")
+        || text.contains("demanda alta")
+        || text.contains("demanda media");
+  }
+
+  private static String semantic(String raw) {
+    return OfferParser.normalize(raw)
+        .replaceAll("[^a-z0-9]+", "_")
+        .replaceAll("^_+|_+$", "");
+  }
 }
