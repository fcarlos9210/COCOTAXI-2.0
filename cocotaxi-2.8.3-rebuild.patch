+  @Test
+  public void acceptanceRequirementIsUsedOnlyWhenPromotionShowsIt() {
+    PromotionRequirementParser.Requirement none =
+        PromotionRequirementParser.parse("Promo: 11 viajes, premio $1100");
+    assertFalse(none.found);
+
+    PromotionRequirementParser.Requirement explicit =
+        PromotionRequirementParser.parse(
+            "Promoción 11 viajes\nTasa de aceptación mínima 80%\nTu tasa actual 84%\n"
+                + "Viajes recibidos 25\nViajes aceptados 21");
+    assertTrue(explicit.found);
+    assertEquals(80, explicit.targetRate, .001);
+    assertEquals(84, explicit.currentRate, .001);
+    assertEquals(25, explicit.offeredJourneys);
+    assertEquals(21, explicit.acceptedJourneys);
+    assertEquals(11, explicit.tripTarget);
+
+    PromotionRequirementParser.Requirement split =
+        PromotionRequirementParser.parse(
+            "Detalle de promoción\nTasa de aceptación\nMínimo 80%\nTu tasa actual\n84%");
+    assertTrue(split.found);
+    assertEquals(80, split.targetRate, .001);
+    assertEquals(84, split.currentRate, .001);
+  }
+
+  @Test
+  public void unverifiedRequiredTaPreventsInventingPromotionCredit() {
+    long now = System.currentTimeMillis();
+    PromotionStore.Snapshot promo = new PromotionStore.Snapshot();
+    promo.target = 11;
+    promo.completed = 0;
+    promo.bonus = 1100;
+    promo.start = now - 60_000;
+    promo.end = now + 4 * 60 * 60_000L;
+    promo.now = now;
+    promo.acceptanceRequired = true;
+    promo.acceptanceTarget = 80;
+    promo.acceptanceCurrent = -1;
+    promo.acceptanceObservedAt = now;
+
+    DecisionEngine.Result unknown =
+        DecisionEngine.evaluate(offer(160, 5, 15), values(600), session(), 2, null, promo);
+    assertFalse(unknown.promoFeasible);
+    assertTrue(unknown.promoTaUnverified);
+    assertFalse(unknown.accept);
+
+    promo.acceptanceCurrent = 84;
+    DecisionEngine.Result eligible =
+        DecisionEngine.evaluate(offer(160, 5, 15), values(600), session(), 2, null, promo);
+    assertTrue(eligible.promoFeasible);
+    assertTrue(eligible.promoTaRequired);
+    assertTrue(eligible.accept);
+  }
+
+  @Test
+  public void cancelActionIsNotTerminalButConfirmedCancellationIs() {
+    assertFalse(AssignmentSignals.isCancelledNormalized("cancelar viaje"));
+    assertTrue(AssignmentSignals.isAssignedNormalized("ruta al destino · cancelar viaje"));
+    assertTrue(AssignmentSignals.isCancelledNormalized("el pasajero canceló · viaje cancelado"));
+    assertTrue(AssignmentSignals.isCancelledNormalized("has cancelado el viaje"));
+    assertTrue(AssignmentSignals.isCancellationSemantic("jf_journey_cancelled_screen"));
+  }
