+  /** Append completed rides to the user-created monthly JSONL export. */
+  public int exportCompletedTrips(OutputStream out, YearMonth month) throws IOException {
+    long start = month.atDay(1).atStartOfDay(ZONE).toInstant().toEpochMilli();
+    long end = month.plusMonths(1).atDay(1).atStartOfDay(ZONE).toInstant().toEpochMilli();
+    String tripDate = "CASE WHEN origin='MANUAL' OR completed_at<=0 THEN at ELSE completed_at END";
+    int count = 0;
+    try (Cursor q = getReadableDatabase().rawQuery(
+        "SELECT id,session,at,completed_at,actual,estimate,cost,minutes,origin,offered,"
+            + tripDate + " FROM trips WHERE deleted=0 AND trip=1 AND status='FINALIZADO'"
+            + " AND " + tripDate + ">=CAST(? AS INTEGER)"
+            + " AND " + tripDate + "<CAST(? AS INTEGER) ORDER BY " + tripDate + ",id",
+        new String[] {Long.toString(start), Long.toString(end)})) {
+      while (q.moveToNext()) {
+        try {
+          JSONObject row = new JSONObject();
+          row.put("type", "trip_completed");
+          row.put("id", q.getString(0));
+          row.put("session", q.getString(1));
+          row.put("at", q.getLong(10));
+          row.put("offer_at", q.getLong(2));
+          row.put("recorded_at", q.getLong(3));
+          row.put("importe_cents", (q.isNull(4) ? q.getLong(5) : q.getLong(4)) - q.getLong(6));
+          row.put("payment_confirmed", !q.isNull(4));
+          row.put("actual_cents", q.isNull(4) ? JSONObject.NULL : q.getLong(4));
+          row.put("estimated_cents", q.getLong(5));
+          row.put("cost_cents", q.getLong(6));
+          row.put("duration_seconds", Math.round(q.getDouble(7) * 60));
+          row.put("origin", q.getString(8));
+          row.put("offered_cents", Money.cents(q.getDouble(9)));
+          out.write((row.toString() + "\n").getBytes(StandardCharsets.UTF_8));
+          count++;
+        } catch (org.json.JSONException e) {
+          throw new IOException("No se pudo preparar el viaje exportado", e);
+        }
+      }
+    }
+    return count;
+  }
+
