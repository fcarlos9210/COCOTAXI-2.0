@@ -229,7 +229,25 @@ public final class SettingsStore {
   public static double targetHoursForDay(Values values, int mondayBasedDay) {
     double hours = dayHours(values, mondayBasedDay);
     if (hours > 0 && (values.workDaysMask & (1 << mondayBasedDay)) != 0) return hours;
-    return 1.0;
+    // A non-work day must not collapse the economic model to a fake 1-hour jornada.
+    // Use the average configured jornada so editing $/h, jornada or weekly goals always
+    // produces equivalent values, even when settings are changed on a day off.
+    return representativeTargetHours(values);
+  }
+
+  public static double representativeTargetHours(Values values) {
+    double total = 0;
+    int days = 0;
+    for (int i = 0; i < 7; i++) {
+      if ((values.workDaysMask & (1 << i)) == 0) continue;
+      double h = dayHours(values, i);
+      if (h > 0) {
+        total += clamp(h, 1, 18);
+        days++;
+      }
+    }
+    if (days > 0) return total / days;
+    return clamp(values.targetHoursDay > 0 ? values.targetHoursDay : 8, 1, 18);
   }
 
   private static double dayHours(Values values, int day) {
