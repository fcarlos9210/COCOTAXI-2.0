+  assertEquals(8000,hourly.dailyGoal,.001);
+  assertEquals(48000,hourly.weeklyGoal,.001);
+
+  SettingsStore.Values daily=new SettingsStore.Values();
+  daily.goalMode=1;daily.dailyGoal=8000;daily.workDaysMask=0x3f;
+  daily.workDayHours=new double[]{10,10,10,10,10,10,0};
