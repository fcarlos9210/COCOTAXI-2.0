   public static boolean isCompletedNormalized(String text) {
     if (text == null || OfferParser.isHistoryNormalized(text)) return false;
-    return text.contains("viaje finalizado")
-        || text.contains("viaje terminado")
-        || text.contains("viaje completado")
-        || text.contains("califica el viaje")
-        || text.contains("calificar viaje")
-        || text.contains("resumen del viaje");
+    boolean explicit =
+        text.contains("viaje finalizado")
+            || text.contains("viaje terminado")
+            || text.contains("viaje completado")
+            || text.contains("califica el viaje")
+            || text.contains("calificar viaje")
+            || text.contains("resumen del viaje");
+    if (explicit) return true;
+
+    // Cabify's current finished summary does not always expose the title to Accessibility/OCR.
+    // These combinations come from its finished-state resources and are specific enough to avoid
+    // treating an ordinary dialog containing only "Entendido" as a completed ride.
+    return text.contains("viajes finalizados hoy")
+        || text.contains("estamos calculando tu ganancia final")
+        || (text.contains("para ti") && text.contains("ver detalles") && text.contains("entendido"))
+        || (text.contains("pago en la app") && text.contains("ver detalles") && text.contains("entendido"))
+        || (text.contains("pago en efectivo") && text.contains("ver detalles") && text.contains("entendido"));
+  }
+
+  /** Strong idle-map evidence; unlike generic demand text this should not be present mid-journey. */
+  public static boolean isIdleMainMapNormalized(String text) {
+    if (text == null || text.isEmpty()) return false;
+    return text.contains("buscar viajes")
+        || text.contains("estas conectado")
+        || text.contains("estas en linea");
   }

   /** Main-map evidence used only after the driver explicitly requested Finish. */
