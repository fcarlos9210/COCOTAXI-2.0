+package com.cocotaxi.app;
+
+import android.content.Context;
+import android.graphics.Rect;
+import org.json.JSONObject;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.time.*;
+import java.util.*;
+import java.util.concurrent.*;
+
+/** Private monthly observation log. These observations never change trip income or autoaccept. */
+public final class CocoDataStore {
+  private static final ExecutorService IO = Executors.newSingleThreadExecutor(r -> {
+    Thread t = new Thread(r, "CocoObservations");
+    t.setDaemon(true);
+    return t;
+  });
+  private static final Map<String, Long> RECENT = new HashMap<>();
+
+  private CocoDataStore() {}
+
+  public static File currentFile(Context context, long now) {
+    String month = Instant.ofEpochMilli(now).atZone(CocoStore.ZONE).toLocalDate()
+        .toString().substring(0, 7);
+    return new File(new File(context.getFilesDir(), "datos"), "observacion_" + month + ".jsonl");
+  }
+
+  private static String area(String raw) {
+    String s = OfferParser.normalize(raw == null ? "" : raw).replaceAll("[^a-z0-9 ]", " ")
+        .replaceAll("\\s+", " ").trim();
+    return s.length() > 80 ? s.substring(0, 80) : s;
+  }
+
+  private static synchronized boolean first(String key, long now, long window) {
+    long last = RECENT.getOrDefault(key, Long.MIN_VALUE);
+    if (last != Long.MIN_VALUE && now >= last && now - last < window) return false;
+    if (RECENT.size() > 500) RECENT.entrySet().removeIf(e -> now - e.getValue() > 3600000L);
+    RECENT.put(key, now);
+    return true;
+  }
+
+  public static void offer(Context context, String sessionId, Offer offer,
+      DecisionEngine.Result result, boolean ocr) {
+    if (offer == null || result == null || !offer.hasEnoughForDecision()) return;
+    long now = System.currentTimeMillis();
+    if (!first("O:" + sessionId + ":" + offer.key, now, 300000L)) return;
+    try {
+      JSONObject row = new JSONObject();
+      row.put("type", "offer"); row.put("at", now); row.put("session", sessionId);
+      row.put("pickup", area(offer.pickupArea)); row.put("destination", area(offer.destinationArea));
+      row.put("fare_cents", Money.cents(offer.fare));
+      row.put("pickup_min", offer.pickupMin); row.put("trip_min", offer.tripMin);
+      row.put("hourly", Double.isFinite(result.hourly) ? result.hourly : 0);
+      row.put("pickup_heat", offer.pickupHeat); row.put("destination_heat", offer.destinationHeat);
+      row.put("ocr", ocr);
+      enqueue(context, row, now);
+    } catch (Exception ignored) { }
+  }
+
+  /** Screen hexes are relative to the current Cabify viewport; label is the stable map anchor. */
+  public static void mapCell(Context context, String label, int heat, Rect bounds,
+      int width, int height, long now) {
+    String place = area(label);
+    if (place.isEmpty() || heat < 2 || width <= 0 || height <= 0 || bounds == null) return;
+    int col = Math.max(0, Math.min(11, bounds.centerX() * 12 / width));
+    int rowIndex = Math.max(0, Math.min(19, bounds.centerY() * 20 / height));
+    if (!first("H:" + place + ":" + heat, now, 60000L)) return;
+    try {
+      JSONObject row = new JSONObject();
+      row.put("type", "map_cell"); row.put("at", now); row.put("label", place);
+      row.put("heat", heat); row.put("screen_col", col); row.put("screen_row", rowIndex);
+      row.put("viewport_relative", true);
+      enqueue(context, row, now);
+    } catch (Exception ignored) { }
+  }
+
+  private static void enqueue(Context context, JSONObject row, long now) {
+    File file = currentFile(context.getApplicationContext(), now);
+    File root = file.getParentFile();
+    IO.execute(() -> {
+      if (!root.exists() && !root.mkdirs()) return;
+      try (FileOutputStream out = new FileOutputStream(file, true)) {
+        out.write((row.toString() + "\n").getBytes(StandardCharsets.UTF_8));
+      } catch (IOException e) {
+        android.util.Log.w("COCO_DATA", "observation", e);
+      }
+    });
+  }
+
+  public static final class Forecast {
+    public final String place;
+    public final int samples;
+    public final double medianHourly;
+    public final int heat;
+    Forecast(String place, int samples, double medianHourly, int heat) {
+      this.place = place; this.samples = samples; this.medianHourly = medianHourly; this.heat = heat;
+    }
+  }
+
+  /** Only places with at least three observations at a similar local hour are displayed. */
+  public static List<Forecast> forecasts(Context context, long now) {
+    Map<String, List<Double>> rates = new HashMap<>();
+    Map<String, Integer> heat = new HashMap<>();
+    File root = new File(context.getFilesDir(), "datos");
+    File[] files = root.listFiles((dir, name) -> name.matches("observacion_[0-9]{4}-[0-9]{2}\\.jsonl"));
+    if (files == null) return Collections.emptyList();
+    int hour = Instant.ofEpochMilli(now).atZone(CocoStore.ZONE).getHour();
+    DayOfWeek day = Instant.ofEpochMilli(now).atZone(CocoStore.ZONE).getDayOfWeek();
+    for (File file : files) {
+      // A bounded read prevents a long-running driver's log from blocking the UI indefinitely.
+      if (file.length() > 8_000_000) continue;
+      try (BufferedReader in = new BufferedReader(new InputStreamReader(
+          new FileInputStream(file), StandardCharsets.UTF_8))) {
+        for (String line; (line = in.readLine()) != null;) {
+          JSONObject o = new JSONObject(line);
+          long at = o.optLong("at");
+          if (at > now || now - at > 30L * 86400000L) continue;
+          int observedHour = Instant.ofEpochMilli(at).atZone(CocoStore.ZONE).getHour();
+          if (Instant.ofEpochMilli(at).atZone(CocoStore.ZONE).getDayOfWeek() != day) continue;
+          int diff = Math.abs(hour - observedHour);
+          if (Math.min(diff, 24 - diff) > 2) continue;
+          if ("offer".equals(o.optString("type"))) {
+            String place = o.optString("pickup");
+            double hourly = o.optDouble("hourly");
+            if (!place.isEmpty() && hourly > 0 && hourly < 10000)
+              rates.computeIfAbsent(place, k -> new ArrayList<>()).add(hourly);
+          } else if ("map_cell".equals(o.optString("type"))) {
+            String place = o.optString("label");
+            heat.put(place, Math.max(heat.getOrDefault(place, 0), o.optInt("heat")));
+          }
+        }
+      } catch (Exception e) {
+        android.util.Log.w("COCO_DATA", "read observation", e);
+      }
+    }
+    List<Forecast> result = new ArrayList<>();
+    for (Map.Entry<String, List<Double>> entry : rates.entrySet()) {
+      List<Double> values = entry.getValue();
+      if (values.size() < 3) continue;
+      Collections.sort(values);
+      result.add(new Forecast(entry.getKey(), values.size(),
+          values.get(values.size() / 2), heat.getOrDefault(entry.getKey(), -1)));
+    }
+    result.sort((a, b) -> Double.compare(b.medianHourly, a.medianHourly));
+    return result;
+  }
+
+  static void awaitWritesForTests() throws Exception { IO.submit(() -> {}).get(5, TimeUnit.SECONDS); }
+}
