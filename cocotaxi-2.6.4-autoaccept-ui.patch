+  @Test
+  public void listAutoAcceptCanTargetSingleOrBoundedBestCard() {
+    Offer bounded = new Offer();
+    bounded.top = 350; bounded.bottom = 650;
+    assertTrue(CocotaxiAccessibilityService.canTargetAccept(
+        java.util.Collections.singletonList(bounded), 1, true, bounded));
+    Offer first = new Offer();
+    first.top = 0; first.bottom = 300;
+    assertTrue(CocotaxiAccessibilityService.canTargetAccept(
+        java.util.Arrays.asList(first, bounded), 2, true, bounded));
+    Offer unbounded = new Offer();
+    assertFalse(CocotaxiAccessibilityService.canTargetAccept(
+        java.util.Arrays.asList(first, unbounded), 2, true, unbounded));
+  }
