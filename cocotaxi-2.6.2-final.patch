+  private static boolean clickOfferInBounds(
+      AccessibilityNodeInfo n, Offer wanted, int depth, int[] visited) {
+    if (n == null || depth > 30 || visited[0]++ > 600 || !n.isVisibleToUser()) return false;
+
+    if (isAcceptLabelFast(n)) {
+      Rect bounds = new Rect();
+      n.getBoundsInScreen(bounds);
+      int center = bounds.centerY();
+      boolean inside =
+          wanted.bottom > wanted.top
+              ? center >= wanted.top && center <= wanted.bottom
+              : Math.abs(center - wanted.top) <= 48;
+      if (inside && clickNodeOrAncestor(n)) return true;
+    }
+
+    for (int i = 0; i < n.getChildCount(); i++) {
+      AccessibilityNodeInfo child = n.getChild(i);
+      if (child == null) continue;
+      try {
+        if (clickOfferInBounds(child, wanted, depth + 1, visited)) return true;
+      } finally {
+        child.recycle();
+      }
+    }
+    return false;
+  }
+
+  private static boolean clickNodeOrAncestor(AccessibilityNodeInfo n) {
+    if (n.isVisibleToUser() && n.isEnabled() && n.isClickable())
+      return n.performAction(AccessibilityNodeInfo.ACTION_CLICK);
+
+    AccessibilityNodeInfo current = n.getParent();
+    try {
+      for (int i = 0; i < 4 && current != null; i++) {
+        if (current.isVisibleToUser() && current.isEnabled() && current.isClickable())
+          return current.performAction(AccessibilityNodeInfo.ACTION_CLICK);
+        AccessibilityNodeInfo parent = current.getParent();
+        current.recycle();
+        current = parent;
+      }
+      return false;
+    } finally {
+      if (current != null) current.recycle();
+    }
   }
 }
