+  @Test
+  public void manuallyAcceptedRejectedOfferStartsOneRealTripAndClock() {
+    Offer offer = OfferParser.parse("Para ti $188\n3 min\n9 min\nAceptar", "com.cabify.driver");
+    DecisionEngine.Result rejected = new DecisionEngine.Result();
+    rejected.offer = offer;
+    rejected.accept = false;
+    rejected.payout = 188;
+    rejected.minutes = 12;
+    String id = st.recordManualAcceptance(offer, rejected);
+    assertNotNull(id);
+    assertEquals("ASIGNADO", st.find(id).status);
+    assertEquals(id, st.recordManualAcceptance(offer, rejected));
+    assertEquals(id, st.observedAssignment(offer, rejected, false));
+    ShadowSystemClock.advanceBy(Duration.ofMinutes(2));
+    assertEquals(1, st.session().trips);
+    assertTrue(st.tripDuration(st.find(id)) >= 2);
+    assertEquals(1, st.trips(st.session().id).size());
+  }
+
+  @Test
