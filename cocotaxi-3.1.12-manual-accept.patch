+  /** A driver's Cabify acceptance is recorded regardless of Coco's recommendation. */
+  public synchronized String recordManualAcceptance(Offer offer, DecisionEngine.Result result) {
+    Session s = session();
+    if (!s.active || s.paused) return null;
+    Trip current = activeTrip();
+    Trip queued = nextTrip();
+    if (offer != null && offer.hasEnoughForDecision()) {
+      for (Trip existing : new Trip[] {current, queued}) {
+        if (existing != null && offer.key.equals(existing.key)) {
+          if ("INTENTO".equals(existing.status) || "INTENTO_SIGUIENTE".equals(existing.status))
+            confirmAccepted(existing.id);
+          return existing.id;
+        }
+      }
+      String id = attempt(offer, result, false);
+      if (id != null) confirmAccepted(id);
+      return id;
+    }
+    // A real Cabify Accept click can arrive after the fare has vanished from Accessibility.
+    // Confirm a pending attempt or start an amount-pending ride; the final payment can fill it.
+    if (current != null && "INTENTO".equals(current.status)) {
+      confirmAccepted(current.id);
+      return current.id;
+    }
+    if (queued != null && "INTENTO_SIGUIENTE".equals(queued.status)) {
+      confirmAccepted(queued.id);
+      return queued.id;
+    }
+    return current == null ? observedAssignment(null, null, false) : null;
+  }
