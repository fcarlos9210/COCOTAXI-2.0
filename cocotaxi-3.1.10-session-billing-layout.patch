+  /** Recorded pickup and passenger time, plus the live segment while assigned. */
+  public double tripDuration(Trip t) {
+    return Math.max(0, t.minutes) + ("ASIGNADO".equals(t.status) ? activeSegmentMinutes(t) : 0);
+  }
+
+  /** Sum of completed trips recorded by Coco on a Montevideo calendar day. */
+  public double dailyTripTotal(String day) {
+    LocalDate date = LocalDate.parse(day);
+    long start = date.atStartOfDay(ZONE).toInstant().toEpochMilli();
+    long end = date.plusDays(1).atStartOfDay(ZONE).toInstant().toEpochMilli();
+    try (Cursor q = getReadableDatabase().rawQuery(
+        "SELECT COALESCE(SUM((COALESCE(actual,estimate)-COALESCE(cost,0))/100.0),0)"
+            + " FROM trips WHERE deleted=0 AND trip=1 AND status='FINALIZADO'"
+            + " AND (CASE WHEN origin='MANUAL' OR completed_at<=0 THEN at ELSE completed_at END)>=?"
+            + " AND (CASE WHEN origin='MANUAL' OR completed_at<=0 THEN at ELSE completed_at END)<?",
+        new String[] {Long.toString(start), Long.toString(end)})) {
+      return q.moveToFirst() ? q.getDouble(0) : 0;
+    }
+  }
